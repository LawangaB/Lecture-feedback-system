# Use a dedicated local test database. Tests verify the hostname and database name
# before running the destructive database cleanup in tests/helpers.ts.
DATABASE_URL=postgresql://lfps_test:replace-with-local-password@localhost:5432/lecture_feedback_test?schema=public
TEST_DATABASE_URL=postgresql://lfps_test:replace-with-local-password@localhost:5432/lecture_feedback_test?schema=public

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
JOIN_CODE_KEY=replace-with-a-random-key-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
