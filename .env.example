# Copy to backend/.env (local development) or supply via your platform's secret manager.
# Placeholders only — generate real values, e.g.:  openssl rand -base64 48
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://lfps:change-me-local-only@localhost:5432/lecture_feedback?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
JOIN_CODE_KEY=replace-with-another-32-plus-random-characters
SESSION_COOKIE_NAME=lfps.sid
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=24
JOIN_CODE_TTL_MINUTES=180
TRUST_PROXY=0
LOG_LEVEL=info
# Optional: serve the built frontend from the API process
# SERVE_STATIC_DIR=../frontend/dist

# docker-compose only
POSTGRES_USER=lfps
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lecture_feedback
